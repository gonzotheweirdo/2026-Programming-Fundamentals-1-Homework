# This function will print 51-character squiggly borders above and below the string parameter or just border if string is empty
def squigglyWrap(text):
    squiggly = '\n' + '~ ' * 25 + '~\n'
    wrapped = squiggly + '\t' + text + squiggly
    
    if text == '':
        return squiggly
    else:
        return wrapped

